---
import Base from '../layouts/Base.astro';
import SquiggleDivider from '../components/SquiggleDivider.astro';

const tools = [
  {
    name: 'Raglan Generator',
    tagline: 'Put in your gauge and measurements. Get back a complete top-down raglan pattern.',
    href: '/knitting-resizer',
    color: 'var(--pp-terracotta)',
    status: 'Live',
    facts: [
      { label: 'Construction',   value: 'Top-down raglan' },
      { label: 'Plus-size aware', value: 'Yes — built in from day one' },
      { label: 'You bring',      value: 'Gauge swatch + measurements' },
      { label: 'You get',        value: 'A full written pattern' },
    ],
    description:
      'Stitch counts, yoke depth, increase schedule, sleeve taper, waist shaping — all of it. No pattern to buy. No scaling up a size medium and hoping for the best.',
    comingSoon: false,
  },
  {
    name: 'Pattern Grader',
    tagline: 'You love the pattern. It just doesn\'t fit. Enter its stitch counts and we\'ll regrade it to your size.',
    href: '/resize-my-pattern',
    color: 'var(--pp-clary-sage)',
    status: 'In development',
    facts: [
      { label: 'Constructions',  value: 'Raglan, bottom-up seamed' },
      { label: 'Plus-size aware', value: 'Yes' },
      { label: 'You bring',      value: 'Your pattern + your measurements' },
      { label: 'You get',        value: 'A regraded version of that pattern' },
    ],
    description:
      'You open your pattern. The tool walks you through the key numbers — cast-on, yoke end, chest, waist, hem. It checks that they add up, then regrades those proportions to your body. The designer\'s math, for your size.',
    comingSoon: true,
  },
];

const futurePlans = [
  'Drop shoulder generator',
  'Set-in sleeve grader',
  'Circular yoke calculator',
  'Gauge converter (yards → meters and back)',
];
---

<Base
  title="Pattern Tools — Purl Pressure"
  description="Free knitting tools that do the sizing math correctly — including the parts standard grading gets wrong for plus sizes. No AI guessing at your measurements."
>

  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <header class="hero">
    <div class="pp-container hero__inner">
      <div class="hero__copy">
        <p class="pp-eyebrow hero__eyebrow">Pattern Tools</p>
        <h1 class="pp-display pp-display--lg hero__title">
          The math<br/>just <em>works.</em>
        </h1>
        <p class="hero__lede">
          Gauge times stitches per inch equals inches. That's it.
          These tools do that math correctly — including the parts
          standard sizing usually gets wrong for plus sizes.
          No AI is guessing at your measurements.
        </p>
      </div>

      <aside class="hero__manifesto" aria-label="How it works">
        <p class="hero__manifesto-label">How it works</p>
        <ol class="hero__steps">
          <li><span class="hero__step-num">01</span>You put in numbers from your pattern or your swatch</li>
          <li><span class="hero__step-num">02</span>The tool checks they add up</li>
          <li><span class="hero__step-num">03</span>The math runs</li>
          <li><span class="hero__step-num">04</span>You get a written pattern that fits</li>
        </ol>
        <p class="hero__manifesto-note">
          No AI in the math.
          <span class="hero__manifesto-sub">more on that below ↓</span>
        </p>
      </aside>
    </div>
  </header>

  <!-- ── Tool cards ─────────────────────────────────────────────────────── -->
  <section class="pp-section tools-section">
    <div class="pp-container">
      <div class="tools-grid">
        {tools.map(tool => (
          <article class="tool-card" style={`--tool-color: ${tool.color};`}>
            <div class="tool-card__pill">
              <span class="tool-card__dot"></span>
              <span class="tool-card__status">{tool.status}</span>
            </div>

            <div class="tool-card__body">
              <h2 class="tool-card__name">{tool.name}</h2>
              <p class="tool-card__tagline">{tool.tagline}</p>
              <p class="tool-card__desc">{tool.description}</p>
            </div>

            <ul class="tool-card__facts" aria-label="Tool details">
              {tool.facts.map(f => (
                <li class="tool-card__fact">
                  <span class="tool-card__fact-label">{f.label}</span>
                  <span class="tool-card__fact-value">{f.value}</span>
                </li>
              ))}
            </ul>

            <div class="tool-card__footer">
              {tool.comingSoon ? (
                <span class="tool-card__soon">Coming soon</span>
              ) : (
                <div class="tool-card__ctas">
                  <a href={tool.href} class="pp-btn pp-btn--accent">
                    Open {tool.name} →
                  </a>
                  <a href={tool.href} target="_blank" rel="noreferrer" class="tool-card__newtab">
                    Open in new tab ↗
                  </a>
                </div>
              )}
            </div>

            <div class="tool-card__shape" aria-hidden="true"></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <SquiggleDivider />

  <!-- ── Why no AI ─────────────────────────────────────────────────────── -->
  <section class="pp-section philosophy">
    <div class="pp-container">

      <div class="philosophy__header">
        <p class="pp-eyebrow">No AI Needed</p>
        <h2 class="pp-display pp-display--md philosophy__title">
          Just <em>math.</em>
        </h2>
      </div>

      <div class="philosophy__blocks">

        <div class="philosophy__block">
          <h3 class="philosophy__h">Plus-size grading is actually different math.</h3>
          <p class="philosophy__p">
            Scaling a size medium up to a 2X doesn't work — the proportions change.
            Yoke depth grows faster than bust. Upper arm grows faster than everything else.
            Cross-back stops growing past 50". I built these tools to handle that correctly,
            for any size, from scratch.
          </p>
        </div>

        <div class="philosophy__block">
          <h3 class="philosophy__h">A formula is better at algebra than a language model.</h3>
          <p class="philosophy__p">
            Gauge × stitches per inch = inches. I can just write that and solve it.
            If your numbers don't add up, the tool tells you.
            It won't ask if this "looks right" and hope for the best.
          </p>
        </div>

        <div class="philosophy__block">
          <h3 class="philosophy__h">Knitting is an art. It shouldn't be training data.</h3>
          <p class="philosophy__p">
            Pattern designers put real creative work into what they make.
            The knitting community has been pretty vocal about not wanting that used
            to train AI that could replicate it — and I'm with them.
            These tools do sizing math. That's it.
            Nothing creative is being processed, scraped, or fed anywhere.
          </p>
        </div>

      </div>

      <!-- Transparency callout -->
      <aside class="transparency" role="note">
        <p class="transparency__mark" aria-hidden="true">✶</p>
        <div class="transparency__copy">
          <p class="transparency__headline">One thing to be upfront about</p>
          <p class="transparency__body">
            I used Claude to write most of the Python and TypeScript — I'm not precious about that part.
            The sizing math, the plus-size formulas, the validation rules, the tests — those are all mine.
            I worked them out and checked them against real patterns.
            Claude had nothing to do with the sizing decisions. Felt like that was worth saying.
          </p>
        </div>
      </aside>

    </div>
  </section>

  <SquiggleDivider />

  <!-- ── Coming up ─────────────────────────────────────────────────────── -->
  <section class="pp-section upcoming">
    <div class="pp-container upcoming__inner">
      <div class="upcoming__copy">
        <p class="pp-eyebrow">On the roadmap</p>
        <h2 class="pp-display pp-display--md upcoming__title">
          More coming.<br/><em>Same deal.</em>
        </h2>
        <p class="upcoming__sub">
          More constructions, same approach — real math, plus-size aware from the start.
        </p>
      </div>
      <ul class="upcoming__list" aria-label="Upcoming tools">
        {futurePlans.map(item => (
          <li class="upcoming__item">
            <span class="upcoming__dot" aria-hidden="true">◦</span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

</Base>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .hero {
    padding: var(--pp-16) 0 var(--pp-14);
    background:
      radial-gradient(ellipse at 80% 0%, color-mix(in srgb, var(--pp-clary-sage) 10%, transparent), transparent 55%),
      radial-gradient(ellipse at 10% 80%, color-mix(in srgb, var(--pp-terracotta) 10%, transparent), transparent 50%),
      var(--pp-bg);
    border-bottom: 1px solid var(--pp-border-soft);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--pp-10);
    align-items: start;
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 3fr 2fr;
      gap: var(--pp-16);
      align-items: center;
    }
  }

  .hero__eyebrow { margin-bottom: var(--pp-4); }

  .hero__title {
    margin: 0 0 var(--pp-6);
  }
  .hero__title em { color: var(--pp-clary-sage); }

  .hero__lede {
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.6;
    color: var(--pp-text-soft);
    max-width: 50ch;
    margin: 0;
  }

  /* Manifesto card */
  .hero__manifesto {
    padding: var(--pp-5) var(--pp-6);
    background: var(--pp-bg-elevated);
    border: 1px solid var(--pp-border-soft);
    border-radius: var(--pp-radius-md);
    transform: rotate(1deg);
    transition: transform 220ms var(--pp-ease);
  }
  .hero__manifesto:hover { transform: rotate(0); }

  .hero__manifesto-label {
    font-family: var(--pp-font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pp-text-muted);
    margin: 0 0 var(--pp-3);
  }

  .hero__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .hero__steps li {
    display: flex;
    align-items: baseline;
    gap: var(--pp-3);
    font-size: 14px;
    line-height: 1.4;
    color: var(--pp-text-soft);
    padding: var(--pp-2) 0;
    border-bottom: 1px dashed var(--pp-border-soft);
  }
  .hero__steps li:first-child { padding-top: 0; }

  .hero__step-num {
    font-family: var(--pp-font-mono);
    font-size: 11px;
    color: var(--pp-terracotta);
    flex-shrink: 0;
    letter-spacing: 0.06em;
  }

  .hero__manifesto-note {
    font-family: var(--pp-font-display);
    font-style: italic;
    font-weight: 800;
    font-size: 16px;
    line-height: 1.2;
    color: var(--pp-text);
    margin: var(--pp-3) 0 0;
    padding-top: var(--pp-3);
    border-top: 1px solid var(--pp-border-soft);
  }
  .hero__manifesto-sub {
    font-family: var(--pp-font-body);
    font-style: normal;
    font-weight: 400;
    font-size: 12px;
    color: var(--pp-text-muted);
    letter-spacing: 0.04em;
    display: block;
    margin-top: var(--pp-1);
  }

  /* ── Tools grid ─────────────────────────────────────────────────────── */
  .tools-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--pp-8);
  }

  @media (min-width: 820px) {
    .tools-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .tool-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--pp-5);
    padding: var(--pp-8);
    background: var(--pp-bg-elevated);
    border: 1px solid var(--pp-border-soft);
    border-radius: var(--pp-radius-md);
    overflow: hidden;
    transition: border-color 220ms var(--pp-ease), transform 220ms var(--pp-ease);
  }

  .tool-card:hover {
    border-color: var(--tool-color);
    transform: translateY(-3px);
  }

  .tool-card__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: rgba(245, 240, 232, 0.05);
    border: 1px solid var(--pp-border-soft);
    border-radius: 999px;
    align-self: flex-start;
    font-family: var(--pp-font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pp-text-muted);
    position: relative;
    z-index: 2;
  }

  .tool-card__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tool-color);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--tool-color) 25%, transparent);
    flex-shrink: 0;
  }

  .tool-card__body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--pp-3);
  }

  .tool-card__name {
    font-family: var(--pp-font-display);
    font-style: italic;
    font-weight: 900;
    font-size: clamp(30px, 3.5vw, 48px);
    line-height: 1.0;
    letter-spacing: -0.02em;
    color: var(--pp-text);
    margin: 0;
  }

  .tool-card__tagline {
    font-size: 16px;
    line-height: 1.45;
    color: var(--tool-color);
    font-weight: 500;
    margin: 0;
  }

  .tool-card__desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--pp-text-muted);
    margin: 0;
  }

  .tool-card__facts {
    list-style: none;
    margin: 0;
    padding: var(--pp-4) 0 0;
    border-top: 1px solid var(--pp-border-soft);
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
  }

  .tool-card__fact {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--pp-4);
    font-size: 13px;
    padding: var(--pp-2) 0;
    border-bottom: 1px dashed var(--pp-border-soft);
  }
  .tool-card__fact:first-child { padding-top: 0; }
  .tool-card__fact:last-child { border-bottom: none; padding-bottom: 0; }

  .tool-card__fact-label {
    font-family: var(--pp-font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pp-text-muted);
    flex-shrink: 0;
  }

  .tool-card__fact-value {
    color: var(--pp-text-soft);
    text-align: right;
  }

  .tool-card__footer {
    position: relative;
    z-index: 2;
    margin-top: auto;
    padding-top: var(--pp-3);
  }

  .tool-card__ctas {
    display: flex;
    align-items: center;
    gap: var(--pp-5);
    flex-wrap: wrap;
  }

  .tool-card__newtab {
    font-size: 13px;
    color: var(--pp-text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--pp-border-soft);
    transition: color 160ms var(--pp-ease), border-color 160ms var(--pp-ease);
    white-space: nowrap;
  }
  .tool-card__newtab:hover {
    color: var(--pp-text-soft);
    border-color: var(--pp-text-muted);
  }

  .tool-card__soon {
    font-family: var(--pp-font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pp-text-muted);
    padding: 6px 14px;
    border: 1px dashed var(--pp-border-soft);
    border-radius: 999px;
    display: inline-block;
  }

  .tool-card__shape {
    position: absolute;
    width: 260px;
    height: 260px;
    bottom: -120px;
    right: -100px;
    background: var(--tool-color);
    opacity: 0.10;
    border-radius: 50%;
    transition: transform 320ms var(--pp-ease), opacity 320ms var(--pp-ease);
    z-index: 1;
  }
  .tool-card:hover .tool-card__shape {
    transform: scale(1.12) translate(-8px, -8px);
    opacity: 0.18;
  }

  /* ── Philosophy ──────────────────────────────────────────────────────── */
  .philosophy__header {
    margin-bottom: var(--pp-10);
  }

  .philosophy__title {
    margin: var(--pp-3) 0 0;
  }
  .philosophy__title em { color: var(--pp-terracotta); }

  .philosophy__blocks {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--pp-10);
  }

  .philosophy__block {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--pp-4);
    padding: var(--pp-8) 0;
    border-bottom: 1px solid var(--pp-border-soft);
  }
  .philosophy__block:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  @media (min-width: 700px) {
    .philosophy__block {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--pp-12);
      align-items: start;
    }
  }

  .philosophy__h {
    font-family: var(--pp-font-display);
    font-style: italic;
    font-weight: 800;
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--pp-text);
    margin: 0;
  }

  .philosophy__p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--pp-text-soft);
    margin: 0;
  }

  /* Transparency callout */
  .transparency {
    display: flex;
    gap: var(--pp-5);
    align-items: flex-start;
    padding: var(--pp-6) var(--pp-7);
    background: color-mix(in srgb, var(--pp-periwinkle) 7%, var(--pp-bg-elevated));
    border: 1px solid color-mix(in srgb, var(--pp-periwinkle) 28%, transparent);
    border-radius: var(--pp-radius-md);
    transform: rotate(-0.4deg);
    transition: transform 220ms var(--pp-ease);
  }
  .transparency:hover { transform: rotate(0); }

  .transparency__mark {
    font-size: 24px;
    color: var(--pp-periwinkle);
    flex-shrink: 0;
    margin: 0;
    line-height: 1.2;
  }

  .transparency__headline {
    font-family: var(--pp-font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pp-periwinkle);
    margin: 0 0 var(--pp-3);
  }

  .transparency__body {
    font-size: 15px;
    line-height: 1.65;
    color: var(--pp-text-soft);
    margin: 0;
  }

  /* ── Upcoming ────────────────────────────────────────────────────────── */
  .upcoming__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--pp-10);
    align-items: start;
  }

  @media (min-width: 700px) {
    .upcoming__inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--pp-14);
      align-items: center;
    }
  }

  .upcoming__title {
    margin: var(--pp-3) 0 var(--pp-4);
  }
  .upcoming__title em { color: var(--pp-clary-sage); }

  .upcoming__sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--pp-text-muted);
    margin: 0;
  }

  .upcoming__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .upcoming__item {
    display: flex;
    align-items: center;
    gap: var(--pp-4);
    font-size: 16px;
    color: var(--pp-text-soft);
    padding: var(--pp-4) 0;
    border-bottom: 1px solid var(--pp-border-soft);
    transition: color 160ms var(--pp-ease), padding-left 160ms var(--pp-ease);
  }
  .upcoming__item:first-child { padding-top: 0; }
  .upcoming__item:last-child { border-bottom: none; }
  .upcoming__item:hover { color: var(--pp-text); padding-left: var(--pp-2); }

  .upcoming__dot {
    color: var(--pp-clary-sage);
    font-size: 18px;
    line-height: 1;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__manifesto,
    .tool-card,
    .tool-card__shape,
    .transparency { transform: none !important; transition: none !important; }
  }
</style>
