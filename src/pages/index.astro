---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = await getCollection('obsessions', ({ data }) => !data.draft);
const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const featured = posts[0];
const rest = posts.slice(1);

const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base>

  <section class="hero">
    <div class="pp-container hero__inner">
      <p class="hero__byline">Curated by Mallory</p>
      <h1 class="pp-display pp-display--lg hero__title">
        <span class="hero__title-l1">Purl</span><br/>
        <span class="hero__title-l2">Pressure.</span>
      </h1>
      <p class="hero__tag">The knitting internet has a beige problem. This is not that.</p>
      <a href="/weekly-obsessions" class="pp-btn pp-btn--accent">This week's obsessions →</a>
    </div>
  </section>

  {featured && (
    <section class="featured">
      <div class="pp-container">
        <p class="pp-eyebrow featured__label">Latest obsession</p>
        <a href={`/weekly-obsessions/${featured.slug}`} class="featured__card">
          <div class="featured__img" style={`--feat-color: ${featured.data.color}`}>
            <img src={`/obsessions/${featured.slug}/1.png`} alt={featured.data.title} loading="eager" />
          </div>
          <div class="featured__info">
            <p class="featured__date">{fmt.format(featured.data.date)}</p>
            <h2 class="featured__title">{featured.data.title}</h2>
            <p class="featured__excerpt">{featured.data.excerpt}</p>
            <span class="featured__cta">Read it →</span>
          </div>
        </a>
      </div>
    </section>
  )}

  {rest.length > 0 && (
    <section class="recent">
      <div class="pp-container">
        <div class="recent__grid">
          {rest.map((post, i) => (
            <PostCard
              href={`/weekly-obsessions/${post.slug}`}
              title={post.data.title}
              date={post.data.date}
              color={post.data.color}
              accent={post.data.accent}
              coverImage={`/obsessions/${post.slug}/1.png`}
              patternCount={post.data.patterns.length}
              index={i}
            />
          ))}
        </div>
        <div class="recent__foot">
          <a href="/weekly-obsessions" class="pp-btn pp-btn--ghost">See the full archive →</a>
        </div>
      </div>
    </section>
  )}

</Base>

<style>
  /* ── HERO ── */
  .hero {
    position: relative;
    overflow: hidden;
    padding: var(--pp-10) 0 var(--pp-12);
    border-bottom: 1px solid var(--pp-border-soft);
  }

  /* Rotated photo background — portrait image turned landscape */
  .hero::before {
    content: '';
    position: absolute;
    width: 150vw;
    height: 150vw;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(90deg);
    background: url('/IMG_5305.JPEG') center / cover no-repeat;
    z-index: 0;
  }

  /* Dark overlay — lighter than before so tiles read through */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(26,20,16,0.50);
    z-index: 1;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--pp-6);
  }

  @media (min-width: 768px) {
    .hero { padding: var(--pp-16) 0 var(--pp-20); }
    .featured { padding: var(--pp-16) 0 var(--pp-12); }
    .recent { padding: var(--pp-8) 0 var(--pp-16); }
  }

  .hero__byline {
    font-family: var(--pp-font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pp-text-muted);
    margin: 0;
  }

  .hero__title { margin: 0; color: var(--pp-text); }
  .hero__title-l1 { display: inline-block; transform: rotate(-1.2deg); }
  .hero__title-l2 { display: inline-block; transform: rotate(0.8deg) translateX(24px); color: var(--pp-terracotta); }

  .hero__tag {
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.45;
    color: var(--pp-text-soft);
    margin: 0;
    max-width: 38ch;
  }

  /* ── FEATURED ── */
  .featured {
    padding: var(--pp-10) 0 var(--pp-8);
  }

  .featured__label { margin-bottom: var(--pp-6); }

  .featured__card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--pp-8);
  }

  @media (min-width: 720px) {
    .featured__card {
      grid-template-columns: 1.5fr 1fr;
      gap: var(--pp-12);
      align-items: center;
    }
  }

  .featured__img {
    border-radius: var(--pp-radius-md);
    overflow: hidden;
    aspect-ratio: 4/3;
    background: var(--feat-color);
  }

  .featured__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 500ms var(--pp-ease);
  }

  .featured__card:hover .featured__img img { transform: scale(1.03); }

  .featured__date {
    font-family: var(--pp-font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pp-text-muted);
    margin: 0 0 var(--pp-3);
  }

  .featured__title {
    font-family: var(--pp-font-display);
    font-style: italic;
    font-weight: 800;
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.0;
    letter-spacing: -0.02em;
    color: var(--pp-text);
    margin: 0 0 var(--pp-5);
  }

  .featured__excerpt {
    font-size: 16px;
    line-height: 1.6;
    color: var(--pp-text-soft);
    margin: 0 0 var(--pp-6);
    max-width: 46ch;
  }

  .featured__cta {
    font-family: var(--pp-font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pp-terracotta);
  }

  /* ── RECENT ── */
  .recent {
    padding: var(--pp-6) 0 var(--pp-12);
  }

  .recent__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--pp-8);
    margin-bottom: var(--pp-8);
  }

  @media (min-width: 640px) {
    .recent__grid { grid-template-columns: 1fr 1fr; }
  }

  .recent__foot { display: flex; }

  @media (prefers-reduced-motion: reduce) {
    .hero__title-l1, .hero__title-l2 { transform: none; }
    .featured__img img { transition: none; }
  }
</style>
