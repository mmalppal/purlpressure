---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import StickerLabel from '../../components/StickerLabel.astro';

const posts = (await getCollection('obsessions', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base
  title="Weekly Obsessions — Purl Pressure"
  description="A weekly drop of patterns, palettes, and the small details I can't stop thinking about."
>
  <header class="archive-hero">
    <div class="pp-container">
      <span class="archive-hero__sticker">
        <StickerLabel text="THE ARCHIVE" rotate={-5} bg="var(--pp-clary-sage)" color="var(--pp-paper)" />
      </span>
      <h1 class="pp-display pp-display--lg archive-hero__title">
        Weekly<br/><em>obsessions.</em>
      </h1>
      <p class="archive-hero__sub">
        Every week I post the patterns, palettes, and yarn moments that wrecked me. Grouped by vibe, never by category.
      </p>
    </div>
  </header>

  <section class="pp-section archive">
    <div class="pp-container">
      {posts.length > 0 ? (
        <div class="archive__grid">
          {posts.map((post, i) => (
            <PostCard
              href={`/weekly-obsessions/${post.slug}`}
              title={post.data.title}
              date={post.data.date}
              color={post.data.color}
              accent={post.data.accent}
              vibe={post.data.vibe}
              coverImage={`/obsessions/${post.slug}/1.png`}
              patternCount={post.data.patterns.length}
              index={i}
            />
          ))}
        </div>
      ) : (
        <p class="archive__empty">First post drops soon.</p>
      )}
    </div>
  </section>
</Base>

<style>
  .archive-hero {
    padding: var(--pp-16) 0 var(--pp-12);
    border-bottom: 1px solid var(--pp-border-soft);
    background:
      radial-gradient(ellipse at 70% 20%, color-mix(in srgb, var(--pp-clary-sage) 15%, transparent), transparent 60%),
      var(--pp-bg);
  }

  .archive-hero__sticker {
    display: inline-block;
    margin-bottom: var(--pp-6);
  }

  .archive-hero__title {
    margin: 0 0 var(--pp-6);
  }

  .archive-hero__title em {
    color: var(--pp-clary-sage);
    font-style: italic;
  }

  .archive-hero__sub {
    font-size: clamp(17px, 1.4vw, 20px);
    color: var(--pp-text-soft);
    max-width: 50ch;
    margin: 0;
  }

  .archive__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--pp-8);
  }

  @media (min-width: 640px) {
    .archive__grid { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 980px) {
    .archive__grid { grid-template-columns: repeat(3, 1fr); gap: var(--pp-10); }
  }

  .archive__empty {
    padding: var(--pp-12);
    text-align: center;
    font-family: var(--pp-font-display);
    font-style: italic;
    font-size: 24px;
    color: var(--pp-text-muted);
  }
</style>
