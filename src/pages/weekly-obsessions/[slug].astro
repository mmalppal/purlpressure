---
import { getCollection } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import SquiggleDivider from '../../components/SquiggleDivider.astro';
import { fetchPatternData } from '../../lib/ravelry';
import type { RavelryPatternData } from '../../lib/ravelry';

export async function getStaticPaths() {
  const posts = await getCollection('obsessions', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;

const ravelryData: (RavelryPatternData | null)[] = await Promise.all(
  data.patterns.map(p => p.ravelry ? fetchPatternData(p.ravelry) : Promise.resolve(null))
);

const patternImages = data.patterns.map((p, i) => {
  const num = p.image ?? (i + 2);
  const rel = `public/obsessions/${post.slug}/${num}.png`;
  return existsSync(join(process.cwd(), rel)) ? `/obsessions/${post.slug}/${num}.png` : null;
});

const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={`${data.title} — Weekly Obsessions`} description={data.excerpt}>
  <article class="post">
    <header
      class="post__band"
      style={`--band: ${data.color}; --band-accent: ${data.accent};`}
    >
      <div class="pp-container post__band-inner">
        <div class="post__meta">
          <a href="/weekly-obsessions" class="post__back">← Weekly Obsessions</a>
          <p class="pp-eyebrow post__date">{fmt.format(data.date)}</p>
        </div>
<h1 class="pp-display pp-display--lg post__title">{data.title}</h1>
        <p class="post__count">{data.patterns.length} patterns this week</p>
      </div>
      <div class="post__band-shape" aria-hidden="true"></div>
    </header>

    <div class="pp-container post__patterns">
      {data.patterns.map((p, i) => {
        const rv = ravelryData[i];
        const imgSrc = patternImages[i];
        const flip = i % 2 === 1;
        return (
          <div class={`pattern-row${flip ? ' pattern-row--flip' : ''}${!imgSrc ? ' pattern-row--no-img' : ''}`}>
            {imgSrc && (
              <div class="pattern-row__img">
                <img src={imgSrc} alt={p.name} loading={i === 0 ? 'eager' : 'lazy'} />
              </div>
            )}
            <div class="pattern-row__info">
              <h2 class="pattern-row__name">{p.name}</h2>
              <p class="pattern-row__designer">by {p.designer}</p>

              {rv && (rv.yarnWeight || rv.needleSizes?.length || rv.yardage || rv.gauge || rv.sizes || rv.languages?.length) && (
                <dl class="pattern-row__specs">
                  {rv.yarnWeight && <><dt>Yarn Weight</dt><dd>{rv.yarnWeight}{rv.wpi ? ` · ${rv.wpi} wpi` : ''}</dd></>}
                  {rv.needleSizes?.length > 0 && <><dt>Needles</dt><dd>{rv.needleSizes.join(' · ')}</dd></>}
                  {rv.yardage && <><dt>Yardage</dt><dd>{rv.yardage}</dd></>}
                  {rv.gauge && <><dt>Gauge</dt><dd>{rv.gauge}</dd></>}
                  {rv.sizes && <><dt>Sizes</dt><dd>{rv.sizes}</dd></>}
                  {rv.languages?.length > 0 && <><dt>Languages</dt><dd>{rv.languages.join(' · ')}</dd></>}
                </dl>
              )}

              {rv && (rv.rating !== null || rv.difficulty !== null) && (
                <div class="pattern-row__ratings">
                  {rv.rating !== null && (
                    <div class="rating-chip">
                      <span class="rating-chip__val">{rv.rating.toFixed(1)}</span>
                      <span class="rating-chip__star">★</span>
                      <span class="rating-chip__count">{rv.ratingCount?.toLocaleString()} ratings</span>
                    </div>
                  )}
                  {rv.difficulty !== null && (
                    <div class="rating-chip">
                      <span class="rating-chip__label">Difficulty</span>
                      <div class="difficulty-bar">
                        <div class="difficulty-bar__fill" style={`width:${rv.difficulty * 10}%`}></div>
                      </div>
                      <span class="rating-chip__count">{rv.difficulty.toFixed(1)}/10</span>
                    </div>
                  )}
                </div>
              )}

              <div class="pattern-row__actions">
                {p.ravelry && (
                  <a href={p.ravelry} target="_blank" rel="noreferrer" class="pattern-row__link">
                    View on Ravelry →
                  </a>
                )}
                {p.external && (
                  <a href={p.external} target="_blank" rel="noreferrer" class="pattern-row__link">
                    View pattern →
                  </a>
                )}
                {rv?.permalink && (
                  <a
                    href={`https://www.ravelry.com/recommendations?pattern=${rv.permalink}`}
                    target="_blank"
                    rel="noreferrer"
                    class="pattern-row__link pattern-row__link--ghost"
                  >
                    if you like this →
                  </a>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="pp-container post__foot">
      <SquiggleDivider />
      <a href="/weekly-obsessions" class="pp-btn pp-btn--ghost">← Back to the archive</a>
    </div>
  </article>
</Base>

<style>
  /* ── Header band ── */
  .post__band {
    position: relative;
    overflow: hidden;
    background: var(--band);
    color: var(--pp-ink);
    padding: var(--pp-12) 0 var(--pp-14);
    border-bottom: 1px solid var(--pp-border-soft);
  }

  .post__band-inner { position: relative; z-index: 2; }

  .post__band-shape {
    position: absolute;
    width: 480px; height: 480px;
    bottom: -240px; right: -160px;
    background: var(--band-accent);
    border-radius: 50%;
    opacity: 0.5;
    z-index: 1;
  }

  .post__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--pp-5);
  }

  .post__back {
    font-family: var(--pp-font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pp-ink);
    border-bottom: 1px solid transparent;
    transition: border-color 160ms var(--pp-ease);
  }
  .post__back:hover { border-color: var(--pp-ink); }

  .post__date { color: rgba(42, 31, 26, 0.6) !important; }
  .post__title {
    margin: 0 0 var(--pp-4);
    color: var(--pp-ink);
    max-width: 16ch;
  }

  .post__count {
    font-family: var(--pp-font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(42, 31, 26, 0.55);
    margin: 0;
  }

  /* ── Pattern rows ── */
  .post__patterns {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-block: var(--pp-10);
  }

  .pattern-row {
    display: grid;
    grid-template-columns: 1fr;
    border-bottom: 1px solid var(--pp-border-soft);
    padding-bottom: var(--pp-10);
    margin-bottom: var(--pp-10);
  }

  .pattern-row:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  @media (min-width: 720px) {
    .pattern-row {
      grid-template-columns: 1fr 1fr;
      gap: var(--pp-10);
      align-items: center;
    }
    .pattern-row--flip .pattern-row__img { order: 2; }
    .pattern-row--flip .pattern-row__info { order: 1; }
    .pattern-row--no-img {
      grid-template-columns: 1fr;
      max-width: 60ch;
    }
  }

  .pattern-row__img {
    border-radius: var(--pp-radius-md);
    overflow: hidden;
    aspect-ratio: 4/5;
    background: var(--pp-bg-sunken);
  }

  .pattern-row__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms var(--pp-ease);
  }

  .pattern-row:hover .pattern-row__img img {
    transform: scale(1.03);
  }

  .pattern-row__info {
    display: flex;
    flex-direction: column;
    gap: var(--pp-4);
    padding-top: var(--pp-5);
  }

  @media (min-width: 720px) {
    .pattern-row__info { padding-top: 0; }
  }

  .pattern-row__name {
    font-family: var(--pp-font-display);
    font-style: italic;
    font-weight: 800;
    font-size: clamp(28px, 3.5vw, 48px);
    line-height: 1.0;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--pp-text);
  }

  .pattern-row__designer {
    font-family: var(--pp-font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--pp-text-muted);
    margin: 0;
  }

  /* Specs table */
  .pattern-row__specs {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--pp-2) var(--pp-5);
    margin: var(--pp-2) 0 0;
    padding: var(--pp-5);
    background: var(--pp-bg-elevated);
    border: 1px solid var(--pp-border-soft);
    border-radius: var(--pp-radius-md);
    border-left: 3px solid var(--pp-terracotta);
  }

  .pattern-row__specs dt {
    font-family: var(--pp-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pp-text-muted);
    align-self: center;
    white-space: nowrap;
  }

  .pattern-row__specs dd {
    font-size: 14px;
    color: var(--pp-text-soft);
    margin: 0;
    align-self: center;
  }

  /* Ratings */
  .pattern-row__ratings {
    display: flex;
    flex-direction: column;
    gap: var(--pp-3);
  }

  .rating-chip {
    display: flex;
    align-items: center;
    gap: var(--pp-3);
    font-family: var(--pp-font-mono);
    font-size: 12px;
  }

  .rating-chip__val {
    font-size: 18px;
    font-weight: 700;
    color: var(--pp-text);
    font-family: var(--pp-font-display);
  }

  .rating-chip__star { color: var(--pp-honey); font-size: 16px; }

  .rating-chip__label {
    color: var(--pp-text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rating-chip__count {
    color: var(--pp-text-muted);
    letter-spacing: 0.05em;
  }

  .difficulty-bar {
    width: 80px;
    height: 6px;
    background: var(--pp-bg-elevated);
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid var(--pp-border-soft);
  }

  .difficulty-bar__fill {
    height: 100%;
    background: var(--pp-terracotta);
    border-radius: 999px;
  }

  /* Curator's take */
  .pattern-row__take {
    font-family: var(--pp-font-display);
    font-style: italic;
    font-size: 17px;
    line-height: 1.5;
    color: var(--pp-text-soft);
    margin: 0;
  }

  /* Actions row */
  .pattern-row__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pp-3);
    margin-top: var(--pp-2);
  }

  .pattern-row__link {
    display: inline-flex;
    align-items: center;
    padding: var(--pp-3) var(--pp-5);
    background: var(--pp-terracotta);
    color: var(--pp-paper);
    font-family: var(--pp-font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 999px;
    width: fit-content;
    transition: transform 160ms var(--pp-ease), box-shadow 160ms var(--pp-ease);
    box-shadow: 2px 2px 0 var(--pp-cordovan);
  }

  .pattern-row__link:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--pp-cordovan);
  }

  .pattern-row__link--ghost {
    background: transparent;
    color: var(--pp-text-soft);
    border: 1px solid var(--pp-border-soft);
    box-shadow: none;
  }

  .pattern-row__link--ghost:hover {
    border-color: var(--pp-text-muted);
    color: var(--pp-text);
    box-shadow: none;
    transform: translate(-1px, -1px);
  }

  /* ── Footer ── */
  .post__foot {
    padding-bottom: var(--pp-14);
  }

  @media (prefers-reduced-motion: reduce) {
    .pattern-row__img img,
    .pattern-row__link { transform: none; transition: none; }
  }
</style>
