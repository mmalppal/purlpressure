---
<Base
  title="Seasonal Skeins — Purl Pressure"
  description="The 16 color seasons decoded for yarn lovers — palette hex codes, DK picks, and lace picks for every sub-season."
>
  <!-- ── Hero ────────────────────────────────────────────────── -->
  <header class="ss-hero">
    <div class="pp-container ss-hero__inner">
      <span class="ss-hero__sticker">
        <StickerLabel text="COLOR ANALYSIS" rotate={-4} bg="var(--pp-periwinkle)" color="var(--pp-paper)" />
      </span>
      <h1 class="pp-display pp-display--xl ss-hero__title">
        Seasonal<br /><em>skeins.</em>
      </h1>
      <p class="ss-hero__sub">
        The 16 color seasons, decoded for yarn lovers.
      </p>
    </div>
  </header>

  <!-- ── Premise ───────────────────────────────────────────── -->
  <section class="pp-section ss-concept">
    <div class="pp-container ss-concept__inner">
      <div class="ss-concept__text">
        <p class="pp-eyebrow">The premise</p>
        <h2 class="ss-concept__h2">A framework.<br /><em>Not a rule.</em></h2>
        <p>
          The 16-season system maps skin and hair coloring to colors that tend to work. Warm or cool undertone. Light or dark value. Bright or muted chroma. Colors close to your natural coloring usually hold up better near your face — they enhance rather than compete. That's the logic.
        </p>
        <p>
          You can ignore it completely. Wear what you love.
        </p>
        <p class="ss-concept__note">
          Yarn picks focus on superwash merino and baby alpaca blends — soft enough for anything worn near the face. Hex codes are approximate; always check physical skeins in natural daylight.
        </p>
      </div>
      <nav class="ss-season-index" aria-label="Jump to season">
        <p class="pp-eyebrow">Jump to</p>
        {seasons.map(s => (
          <a href={`#${s.id}`} class="ss-season-index__link" style={`--s-accent: ${s.accent};`}>
            <span class="ss-season-index__dot"></span>
            <span>
              <span class="ss-season-index__name">{s.name}</span>
              <span class="ss-season-index__tag">{s.tagline}</span>
            </span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- ── Season nav ─────────────────────────────────────────── -->
  <nav class="ss-season-nav" aria-label="Jump to season">
    <div class="pp-container ss-season-nav__inner">
      {seasons.map(s => (
        <a href={`#${s.id}`} class="ss-season-nav__link" style={`--s-accent: ${s.accent};`}>
          {s.name}
        </a>
      ))}
    </div>
  </nav>

  <!-- ── Season sections ───────────────────────────────────── -->
  {seasons.map(season => (
    <section id={season.id} class="ss-season">

      <!-- Season band -->
      <div class="ss-season__band" style={`--band-accent: ${season.accent}; --band-light: ${season.accentLight};`}>
        <div class="pp-container">
          <p class="pp-eyebrow ss-season__eyebrow">The {season.name}s</p>
          <h2 class="ss-season__title pp-display"><em>{season.name}.</em></h2>
          <p class="ss-season__tagline">{season.tagline}</p>
          <p class="ss-season__intro">{season.intro}</p>
        </div>
      </div>

      <!-- Sub-seasons -->
      <div class="pp-container ss-subseasons">
        {season.subseasons.map((sub, i) => (
          <div class="ss-sub">
            <div class="ss-sub__label">
              <h3 class="ss-sub__name">{sub.name}</h3>
            </div>
            <div class="ss-sub__content">
              <p class="ss-sub__overview">{sub.overview}</p>

              <!-- Palette chips -->
              <div class="ss-palette">
                {sub.palette.map(color => (
                  <span class="ss-chip" title={color.name}>
                    <span class="ss-chip__swatch" style={`background: ${color.hex};`}></span>
                    <span class="ss-chip__hex">{color.hex}</span>
                  </span>
                ))}
              </div>

              <!-- DK picks -->
              <div class="ss-yarns">
                <p class="ss-yarns__label">DK picks</p>
                <ul class="ss-yarn-list">
                  {sub.dk.map(y => (
                    <li class="ss-yarn">
                      <span class="ss-yarn__swatch" style={`background: ${y.hex};`} title={y.colorway}></span>
                      <a
                        href={`https://www.google.com/search?q=${encodeURIComponent(y.brand + ' ' + y.colorway)}&tbm=shop`}
                        target="_blank"
                        rel="noreferrer"
                        class="ss-yarn__link"
                      >
                        <span class="ss-yarn__brand">{y.brand}</span>
                        <span class="ss-yarn__colorway">— {y.colorway}</span>
                      </a>
                      <span class="ss-yarn__hex">{y.hex}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Lace picks -->
              <div class="ss-yarns">
                <p class="ss-yarns__label">Lace picks</p>
                <ul class="ss-yarn-list">
                  {sub.lace.map(y => (
                    <li class="ss-yarn">
                      <span class="ss-yarn__swatch" style={`background: ${y.hex};`} title={y.colorway}></span>
                      <a
                        href={`https://www.google.com/search?q=${encodeURIComponent(y.brand + ' ' + y.colorway)}&tbm=shop`}
                        target="_blank"
                        rel="noreferrer"
                        class="ss-yarn__link"
                      >
                        <span class="ss-yarn__brand">{y.brand}</span>
                        <span class="ss-yarn__colorway">— {y.colorway}</span>
                      </a>
                      <span class="ss-yarn__hex">{y.hex}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Feed picks -->
              {sub.feed && sub.feed.length > 0 && (
                <div class="ss-yarns">
                  <p class="ss-yarns__label">From the feed</p>
                  <ul class="ss-yarn-list">
                    {sub.feed.map(y => (
                      <li class="ss-yarn">
                        <span class="ss-yarn__swatch" style={`background: ${y.hex};`} title={y.colorway}></span>
                        <a
                          href={`https://www.google.com/search?q=${encodeURIComponent(y.brand + ' ' + y.colorway)}&tbm=shop`}
                          target="_blank"
                          rel="noreferrer"
                          class="ss-yarn__link"
                        >
                          <span class="ss-yarn__brand">{y.brand}</span>
                          <span class="ss-yarn__colorway">— {y.colorway}</span>
                        </a>
                        <span class="ss-yarn__hex">{y.hex}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <a
                href="https://www.instagram.com/purlpressure/"
                target="_blank"
                rel="noreferrer"
                class="ss-instagram"
              >
                See this on Instagram →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <div class="pp-container ss-squiggle-break">
    <SquiggleDivider />
  </div>

  <!-- ── Footer CTA ─────────────────────────────────────────── -->
  <section class="pp-section ss-cta">
    <div class="pp-container ss-cta__inner">
      <h2 class="pp-display ss-cta__title"><em>Find your season.</em></h2>
      <p class="ss-cta__body">
        The full Seasonal Skeins series lives on Instagram — each post is a carousel with color swatches, yarn photos, and the sub-season breakdown. Follow along at <strong>@purlpressure</strong>.
      </p>
      <a href="https://instagram.com/purlpressure" target="_blank" rel="noreferrer" class="ss-cta__btn">
        Follow on Instagram →
      </a>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .ss-hero {
    padding: var(--pp-16) 0 var(--pp-12);
    background:
      radial-gradient(ellipse at 80% 10%, color-mix(in srgb, var(--pp-periwinkle) 12%, transparent), transparent 55%),
      radial-gradient(ellipse at 10% 80%, color-mix(in srgb, var(--pp-terracotta) 10%, transparent), transparent 50%),
      var(--pp-bg);
    border-bottom: 1px solid var(--pp-border-soft);
  }

  .ss-hero__sticker { display: inline-block; margin-bottom: var(--pp-6); }

  .ss-hero__title {
    margin: 0 0 var(--pp-6);
    line-height: 0.95;
  }

  .ss-hero__title em { color: var(--pp-terracotta); font-style: italic; }

  .ss-hero__sub {
    font-size: clamp(18px, 1.6vw, 24px);
    color: var(--pp-text-soft);
    margin: 0;
    max-width: 44ch;
  }

  /* ── Concept ─────────────────────────────────────────────── */
  .ss-concept__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--pp-12);
    align-items: start;
  }

  @media (min-width: 900px) {
    .ss-concept__inner {
      grid-template-columns: 1fr 280px;
      gap: var(--pp-16);
    }
  }

  .ss-concept__h2 {
    font-family: var(--pp-font-display);
    font-weight: 700;
    font-size: clamp(28px, 3.2vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 var(--pp-8);
    color: var(--pp-text);
  }

  .ss-concept__h2 em { color: var(--pp-clary-sage); font-style: italic; }

  .ss-concept__text p {
    font-size: clamp(17px, 1.4vw, 18px);
    color: var(--pp-text-soft);
    margin: 0 0 var(--pp-5);
    max-width: 60ch;
    line-height: 1.65;
  }

  .ss-concept__note {
    font-family: var(--pp-font-mono);
    font-size: 12px !important;
    letter-spacing: 0.04em;
    color: var(--pp-text-ghost) !important;
    padding: var(--pp-4) var(--pp-5);
    border-left: 2px solid var(--pp-border-strong);
    margin-top: var(--pp-6) !important;
    line-height: 1.6 !important;
  }

  /* Season index sidebar */
  .ss-season-index { display: flex; flex-direction: column; gap: var(--pp-3); }

  .ss-season-index__link {
    display: flex;
    align-items: center;
    gap: var(--pp-4);
    padding: var(--pp-4) var(--pp-5);
    background: var(--pp-bg-elevated);
    border: 1px solid var(--pp-border-soft);
    border-left: 3px solid var(--s-accent);
    border-radius: var(--pp-radius-md);
    text-decoration: none;
    transition: background 160ms var(--pp-ease);
  }

  .ss-season-index__link:hover { background: var(--pp-bg-sunken); }

  .ss-season-index__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--s-accent);
    flex-shrink: 0;
  }

  .ss-season-index__name {
    display: block;
    font-family: var(--pp-font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 18px;
    color: var(--pp-text);
  }

  .ss-season-index__tag {
    display: block;
    font-family: var(--pp-font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pp-text-muted);
  }

  /* ── Season nav ───────────────────────────────────────────── */
  .ss-season-nav {
    position: sticky;
    top: 57px;
    z-index: 40;
    background: color-mix(in srgb, var(--pp-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--pp-border-soft);
  }

  .ss-season-nav__inner {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .ss-season-nav__inner::-webkit-scrollbar { display: none; }

  .ss-season-nav__link {
    flex-shrink: 0;
    padding: var(--pp-4) var(--pp-6);
    font-family: var(--pp-font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pp-text-muted);
    border-bottom: 2px solid transparent;
    transition: color 160ms var(--pp-ease), border-color 160ms var(--pp-ease);
    text-decoration: none;
  }

  .ss-season-nav__link:hover {
    color: var(--pp-text);
    border-color: var(--s-accent);
  }

  /* ── Season sections ──────────────────────────────────────── */
  .ss-season { padding-bottom: var(--pp-16); }

  .ss-season__band {
    padding: var(--pp-12) 0;
    background:
      radial-gradient(ellipse at 0% 50%, color-mix(in srgb, var(--band-accent) 18%, transparent), transparent 60%),
      var(--pp-bg);
    border-bottom: 1px solid var(--pp-border-soft);
    margin-bottom: var(--pp-12);
  }

  .ss-season__eyebrow { margin-bottom: var(--pp-3); color: color-mix(in srgb, var(--band-light) 80%, var(--pp-text-muted)); }

  .ss-season__title {
    margin: 0 0 var(--pp-3);
    font-size: clamp(52px, 7vw, 96px);
    line-height: 0.9;
  }

  .ss-season__title em { color: var(--band-light); font-style: italic; }

  .ss-season__tagline {
    font-family: var(--pp-font-mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pp-text-muted);
    margin: 0 0 var(--pp-5);
  }

  .ss-season__intro {
    font-size: clamp(17px, 1.4vw, 18px);
    color: var(--pp-text-soft);
    max-width: 52ch;
    margin: 0;
    line-height: 1.65;
  }

  /* ── Sub-season rows ──────────────────────────────────────── */
