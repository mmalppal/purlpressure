---
interface Props {
  href: string;
  title: string;
  date: Date;
  color: string;
  accent: string;
  vibe?: string;
  coverImage?: string;
  patternCount?: number;
  index?: number;
  cta?: string;
}
const { href, title, date, color, accent, vibe, coverImage, patternCount, index = 0, cta = 'See the obsessions →' } = Astro.props;

const tilt = index % 2 === 0 ? -1 : 1;
const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<a
  href={href}
  class="card"
  style={`--card-color: ${color}; --card-accent: ${accent}; --card-tilt: ${tilt}deg;`}
>
  <div class="card__img">
    {coverImage
      ? <img src={coverImage} alt={title} class="card__photo" />
      : <div class="card__swatch"><div class="card__color"></div><div class="card__accent"></div></div>
    }
    {vibe && <span class="card__vibe">{vibe}</span>}
    {patternCount && <span class="card__count">{patternCount} patterns</span>}
  </div>

  <div class="card__body">
    <p class="pp-eyebrow card__date">{fmt.format(date)}</p>
    <h3 class="card__title">{title}</h3>
    <span class="card__more">{cta}</span>
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-rows: 260px auto;
    background: var(--pp-bg-elevated);
    border: 1px solid var(--pp-border-soft);
    border-radius: var(--pp-radius-md);
    overflow: hidden;
    transition: transform 220ms var(--pp-ease), border-color 220ms var(--pp-ease), box-shadow 220ms var(--pp-ease);
    transform: rotate(var(--card-tilt));
  }

  .card:hover {
    transform: rotate(0) translateY(-4px);
    border-color: var(--card-color);
    box-shadow: 4px 4px 0 var(--card-color);
  }

  .card__img {
    position: relative;
    overflow: hidden;
    background: var(--card-color);
  }

  .card__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms var(--pp-ease);
  }

  .card:hover .card__photo {
    transform: scale(1.04);
  }

  /* fallback swatch when no image */
  .card__swatch { position: absolute; inset: 0; }
  .card__color { position: absolute; inset: 0; background: var(--card-color); }
  .card__accent {
    position: absolute;
    width: 60%; height: 60%;
    bottom: -20%; right: -15%;
    background: var(--card-accent);
    border-radius: 50%;
  }

  .card__vibe {
    position: absolute;
    top: 12px; left: 12px;
    padding: 4px 10px;
    background: rgba(245, 240, 232, 0.88);
    color: var(--pp-ink);
    font-family: var(--pp-font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 999px;
    transform: rotate(-3deg);
    z-index: 2;
  }

  .card__count {
    position: absolute;
    bottom: 12px; right: 12px;
    padding: 3px 9px;
    background: rgba(26, 20, 16, 0.72);
    color: var(--pp-paper);
    font-family: var(--pp-font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 999px;
    z-index: 2;
  }

  .card__body {
    padding: var(--pp-6);
  }

  .card__date {
    margin: 0 0 var(--pp-3);
  }

  .card__title {
    font-family: var(--pp-font-display);
    font-style: italic;
    font-weight: 800;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 var(--pp-4);
    color: var(--pp-text);
  }

  .card__more {
    font-family: var(--pp-font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--card-color);
    transition: letter-spacing 200ms var(--pp-ease);
  }

  .card:hover .card__more {
    letter-spacing: 0.14em;
  }

  @media (prefers-reduced-motion: reduce) {
    .card, .card:hover, .card__photo, .card__more {
      transform: none;
      transition: none;
      letter-spacing: 0.08em;
    }
  }
</style>
